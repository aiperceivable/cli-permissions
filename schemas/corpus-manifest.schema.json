{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiperceivable.github.io/cli-permissions/schemas/corpus-manifest.schema.json",
  "title": "Overlay Corpus Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "description",
    "version",
    "overlay_directory"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$(?![\\s\\S])"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    },
    "version": {
      "type": "string",
      "maxLength": 256,
      "description": "Corpus release version in SemVer; independent of overlay format and CLI binary versions.",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$(?![\\s\\S])"
    },
    "overlay_directory": {
      "type": "string",
      "minLength": 1,
      "description": "Relative checkout directory containing overlay JSON/YAML files; no parent traversal or .git components.",
      "pattern": "^(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))(?!.*(?:^|[\\\\/])\\.git(?:[\\\\/]|$))(?![A-Za-z]:).+$(?![\\s\\S])"
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/?#@\\s]+(?:[/?#][^\\s]*)?$(?![\\s\\S])",
      "description": "HTTPS homepage with a nonempty host and no embedded credentials."
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    }
  }
}
